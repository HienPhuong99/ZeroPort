{
  "name": "zeroport",
  "version": "0.1.0",
  "private": true,
  "description": "Personal remote desktop: Electron host + web controller over WebRTC",
  "author": "HienPhuong99",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && electron .",
    "app:dev": "electron . --dev",
    "check": "tsc --noEmit",
    "test": "node --test",
    "e2e": "vite build && node scripts/e2e.mjs",
    "dist": "vite build && electron-builder --publish never"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
